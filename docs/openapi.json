  "info": {
    "description": "匿名漂流信系统。信可随机漂向远方（drift），也可埋在某地等后来者发掘（stay）。\n\n**匿名铁律**：一切信件响应使用 LetterPublic，不含任何作者标识。",
    "title": "风信 Kaze no tayori API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "进程存活。不连数据库。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/db": {
      "get": {
        "description": "连库 + 确认 PostGIS 可用。",
        "operationId": "health_db_health_db_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Db Health Db Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Db",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/ai/poem": {
      "post": {
        "description": "从正文提取意象生成 ≤4 行短诗，与正文同屏展示。",
        "operationId": "poem_v1_ai_poem_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Poem",
        "tags": [
          "ai"
        ]
      }
    },
    "/v1/ai/polish": {
      "post": {
        "description": "润色正文，保留原意。用户可选采纳。",
        "operationId": "polish_v1_ai_polish_post",
