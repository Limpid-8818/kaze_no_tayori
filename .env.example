# 风信 Kaze no tayori · 环境变量模板
# 用法：cp .env.example .env 然后填入真实值。.env 永不入库。

# ---------- 应用 ----------
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:*

# ---------- 数据库（默认连接本机 Docker PostGIS，也支持替换为远程地址）----------
# infra/docker-compose.yml 的 db 服务读取这两个变量
POSTGRES_USER=kaze
POSTGRES_PASSWORD=change-me-to-a-local-db-password
# postgis/postgis:17-3.5 只有 amd64；Apple Silicon 由 Docker Desktop 模拟
DB_PLATFORM=linux/amd64
# 运行时用 asyncpg，Alembic 迁移用 psycopg，两条都要填，指向同一个库。
# 修改上面的用户或密码时，也要同步修改下面两条连接串；特殊字符需 URL 编码。
DATABASE_URL=postgresql+asyncpg://kaze:change-me-to-a-local-db-password@127.0.0.1:5432/kazenotayori
DATABASE_URL_SYNC=postgresql+psycopg://kaze:change-me-to-a-local-db-password@127.0.0.1:5432/kazenotayori
# 每人一个 schema，避免共享云库互相踩迁移与种子数据。测试用 test_<yourname>
DB_SCHEMA=dev_yukai

# ---------- 认证 ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=90

# ---------- 产品参数 ----------
DISCOVER_RADIUS_M=1000
LETTER_MAX_CHARS=800
LETTER_MAX_IMAGES=3

# ---------- 可降级模块（PRD §8.3：任一失效不阻断核心循环）----------
# AI 润色与短诗（PRD 6.2）。关闭后写信流降级为纯手动
FEATURE_AI=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 内容审核（PRD 8.2）。关闭或失败时一律 pending 待审，绝不直接 public
FEATURE_MODERATION=false

# 天气（信件落点的「此情此景」锚点之一）—— 和风天气 QWeather
FEATURE_WEATHER=false
WEATHER_API_KEY=
WEATHER_API_HOST=https://devapi.qweather.com

# 逆地理编码（坐标 → 地点名）
FEATURE_GEOCODE=false
AMAP_KEY=
AMAP_API_HOST=https://restapi.amap.com

# ---------- 图片存储 ----------
# local = 写服务器本地磁盘（降级默认）；s3 = 对象存储（七牛 Kodo，走 S3 兼容接口）
STORAGE_BACKEND=local
# 七牛 S3 端点（不带协议），如 s3.cn-east-1.qiniucs.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 公开访问前缀（留空则自动拼为 https://<bucket>.<endpoint>）
# 若有独立 CDN 域名（推荐），填这里，如 https://cdn.example.com
S3_PUBLIC_URL=

# ---------- 前端（--dart-define 注入，不由后端读取）----------
# make app 会用它；真机调试时改成局域网 IP，不能用 localhost
API_BASE_URL=http://localhost:8000
