# 风信 Kaze no tayori · 环境变量模板
# 用法：cp .env.example .env 然后填入真实值。.env 永不入库。

# ---------- 应用 ----------
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:*

# ---------- 数据库（比赛云服务器上的 PostgreSQL + PostGIS）----------
# 运行时用 asyncpg，Alembic 迁移用 psycopg，两条都要填，指向同一个库
DATABASE_URL=postgresql+asyncpg://user:pass@CLOUD_HOST:5432/kazenotayori
DATABASE_URL_SYNC=postgresql+psycopg://user:pass@CLOUD_HOST:5432/kazenotayori
# 每人一个 schema，避免共享云库互相踩迁移与种子数据。测试用 test_<yourname>
DB_SCHEMA=dev_yukai

# ---------- 认证 ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=90

# ---------- 产品参数 ----------
DISCOVER_RADIUS_M=1000
LETTER_MAX_CHARS=800
LETTER_MAX_IMAGES=3

# ---------- 可降级模块（PRD §8.3：任一失效不阻断核心循环）----------
# AI 润色与短诗（PRD 6.2）。关闭后写信流降级为纯手动
FEATURE_AI=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 内容审核（PRD 8.2）。关闭或失败时一律 pending 待审，绝不直接 public
FEATURE_MODERATION=false

# 天气（信件落点的「此情此景」锚点之一）—— 和风天气 QWeather
FEATURE_WEATHER=false
WEATHER_API_KEY=
WEATHER_API_HOST=https://devapi.qweather.com

# 逆地理编码（坐标 → 地点名）
FEATURE_GEOCODE=false
AMAP_KEY=

# ---------- 图片存储 ----------
# local = 写服务器本地磁盘（降级默认）；s3 = 对象存储
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- 前端（--dart-define 注入，不由后端读取）----------
# make app 会用它；真机调试时改成局域网 IP，不能用 localhost
API_BASE_URL=http://localhost:8000
